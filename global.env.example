# Copy to global.env and edit for this host.
# Loaded by svc.sh via: docker compose --env-file ../global.env ...

# --- Drives ----------------------------------------------------------
SSD_PATH=/mnt/ssd
HDD_PATH=/mnt/hdd

# --- Paths (derived) -------------------------------------------------
# Service config / persistent data (SSD)
HOMELAB_SERVICE_DATA_PATH=${SSD_PATH}/services/homelab
# Web sites (self-hosted or client) — separate root per group
WEB_SERVICE_DATA_PATH=${SSD_PATH}/services/web
# HDD media library (movies, tv, ...)
HOMELAB_MEDIA_PATH=${HDD_PATH}/media
# Music library (kept on the SSD)
HOMELAB_MUSIC_PATH=${SSD_PATH}/media/music

# --- Identity / locale ----------------------------------------------
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- svcsh scaffold defaults (manage-service.sh wizard) --------------
# Default network new stacks join; the wizard writes ${SVC_NETWORK} into the
# compose file, so the instance name is defined in one place only.
SVC_NETWORK=homelab-network
# Default group offered by the wizard (empty = no group).
SVC_DEFAULT_GROUP=homelab
# Domain suffix used in Cloudflare tunnel ingress reminders (e.g. myapp.ponado.lt).
SVC_TUNNEL_DOMAIN=ponado.lt
