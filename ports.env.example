# =====================================================================
# Host ports — single source of truth (plain KEY=VALUE, not YAML).
# Instance-specific: copy this file to ports.env and fill in YOUR ports.
# Loaded by svc.sh via: docker compose --env-file <repo>/ports.env ...
#
# Only the HOST side of a mapping uses a variable:
#   ports:
#     - "${MYAPP_PORT}:8080"
# Container-internal ports stay fixed in compose.yml.
#
# Keep one block per numeric range and put new services in the matching
# range: the number then describes the service and collisions are obvious.
# =====================================================================

# ===============================================
# 2800s — web sites (group: web)
# ===============================================
# Most web sites go through the reverse proxy on 80/443 (see Exceptions)
# and need no host port here; use this range only for the rare direct-port site.
# SITE_PORT=2800

# ===============================================
# 3000s — web UIs / dashboards
# ===============================================
# HOMEPAGE_PORT=3000

# ===============================================
# 3100s — media
# ===============================================
# MEDIA_PORT=3100

# ===============================================
# 3200s — apps / automation
# ===============================================
# APP_PORT=3200

# ===============================================
# 3400s — documents
# ===============================================
# DOCS_PORT=3400

# ===============================================
# 3500s — productivity
# ===============================================
# DEV_PORT=3500

# ===============================================
# 3600s — files / storage
# ===============================================
# FILES_PORT=3600

# ===============================================
# 3700s — infrastructure
# ===============================================
# INFRA_PORT=3700

# ===============================================
# Exceptions — services that must keep their real default port.
# Document them here instead of renumbering:
#   DNS 53, VPN 51820, reverse proxy 80/443, torrent peer port 6881, ...
# ===============================================